# SPDX-License-Identifier: Apache-2.0
# Based on containerd v1.7.23 contrib/apparmor/template.go.
# Copyright The docker Authors, The Moby Authors, The containerd Authors.
# Opt-in container profile for nested, unprivileged Codex Bubblewrap sandboxes.
# Keep the standard proc/sys restrictions and the container's capability bound.
# Never combine this with privileged containers or added CAP_SYS_ADMIN.
#include <tunables/global>

profile zoer-codex-computer flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  capability,
  file,
  userns,
  umount,
  pivot_root,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=zoer-codex-computer,
  ptrace (trace,tracedby,read,readby) peer=zoer-codex-computer,

  # Namespace setup and virtual filesystems used by Bubblewrap. Mounts still
  # require kernel capabilities: the outer container has no CAP_SYS_ADMIN.
  mount options=(rslave) -> /,
  mount options=(rw, silent, rslave) -> /,
  mount options=(rprivate) -> /,
  mount options=(rprivate) -> /oldroot/,
  mount options=(rw, silent, rprivate) -> /oldroot/,
  mount options in (bind, rbind, ro, rw, remount, nosuid, nodev, noexec, relatime, silent),
  mount fstype in (tmpfs, proc, devpts),

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/mem rwklx,
  deny @{PROC}/kmem rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
}
